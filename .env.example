VITE_NODE_ENV=development
VITE_APP_BASE_URL=https://offline.bashnota.com
VITE_API_URL=https://api.bashnota.com/api
VITE_AUTH_PROVIDER_VERSION=firebase-v1
VITE_SUPABASE_AUTH_ENABLED=false
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-browser-key
# Set only after the signed C4 reconciliation report passes and Postgres has
# the same restricted marker. Firebase remains the default when these are blank.
VITE_SUPABASE_AUTH_RECONCILIATION_MARKER=
VITE_SUPABASE_AUTH_RECONCILED_PERCENT=0
VITE_SUPABASE_AUTH_IDENTITY_MISMATCHES=0

# Firebase Configuration
VITE_FIREBASE_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=project-id
VITE_FIREBASE_STORAGE_BUCKET=project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=XXXXXXXXXXXXXX
VITE_FIREBASE_APP_ID=X:XXXXXXXXXXXX:web:XXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
