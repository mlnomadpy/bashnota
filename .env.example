VITE_NODE_ENV=development
VITE_APP_BASE_URL=https://offline.bashnota.com
VITE_API_URL=https://api.bashnota.com/api
VITE_AUTH_PROVIDER_VERSION=firebase-v1
VITE_SUPABASE_AUTH_ENABLED=false
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-browser-key
# Set only after the signed C4 reconciliation report passes and Postgres has
# the same restricted marker. Firebase remains the default when these are blank.
VITE_SUPABASE_AUTH_RECONCILIATION_MARKER=
VITE_SUPABASE_AUTH_RECONCILED_PERCENT=0
VITE_SUPABASE_AUTH_IDENTITY_MISMATCHES=0

# Publishing stays Firebase-primary until every independently exported count,
# ID/owner, public link, and metric comparison is green and the same marker is
# enabled by the restricted reconciliation job in publishing_rollout_state.
VITE_PUBLISHING_PROVIDER_VERSION=firebase-v1
VITE_SUPABASE_PUBLISHING_ENABLED=false
VITE_SUPABASE_PUBLISHING_RECONCILIATION_MARKER=
VITE_SUPABASE_PUBLISHING_COUNTS_MATCH=false
VITE_SUPABASE_PUBLISHING_IDENTITIES_MATCH=false
VITE_SUPABASE_PUBLISHING_LINKS_MATCH=false
VITE_SUPABASE_PUBLISHING_METRICS_MATCH=false

# Community interactions remain Firebase-backed until every comparison is
# exact and task 008 explicitly authorizes the cutover.
VITE_COMMUNITY_PROVIDER_VERSION=firebase-v1
VITE_SUPABASE_COMMUNITY_ENABLED=false
VITE_SUPABASE_COMMUNITY_RECONCILIATION_MARKER=
VITE_SUPABASE_COMMUNITY_COMMENTS_MATCH=false
VITE_SUPABASE_COMMUNITY_RELATIONSHIPS_MATCH=false
VITE_SUPABASE_COMMUNITY_VOTES_MATCH=false
VITE_SUPABASE_COMMUNITY_COUNTS_MATCH=false
VITE_SUPABASE_COMMUNITY_SUBSCRIPTIONS_MATCH=false
VITE_SUPABASE_COMMUNITY_TIMESTAMPS_MATCH=false
VITE_SUPABASE_COMMUNITY_ORPHANS_RESOLVED=false
VITE_TASK008_COMMUNITY_CUTOVER_READY=false

# Firebase Configuration
VITE_FIREBASE_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=project-id
VITE_FIREBASE_STORAGE_BUCKET=project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=XXXXXXXXXXXXXX
VITE_FIREBASE_APP_ID=X:XXXXXXXXXXXX:web:XXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
