rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUserAuthenticated(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidUserTag(tag) {
      return tag.matches('^[a-zA-Z0-9_]{3,30}$');
    }

    function isValidVote(vote) {
      return vote == 'like' || vote == 'dislike';
    }

    function voteFor(data) {
      return data.get('votes', {}).get(request.auth.uid, null);
    }

    function hasValidVoteTransition(before, after) {
      let oldVote = voteFor(before);
      let newVote = voteFor(after);
      let oldLikes = before.get('likeCount', 0);
      let oldDislikes = before.get('dislikeCount', 0);
      let newLikes = after.get('likeCount', 0);
      let newDislikes = after.get('dislikeCount', 0);
      return after.diff(before).affectedKeys()
               .hasOnly(['votes', 'likeCount', 'dislikeCount']) &&
             after.get('votes', {}).diff(before.get('votes', {})).affectedKeys()
               .hasOnly([request.auth.uid]) &&
             oldVote != newVote &&
             (newVote == null || isValidVote(newVote)) &&
             newLikes == oldLikes + (newVote == 'like' ? 1 : 0) - (oldVote == 'like' ? 1 : 0) &&
             newDislikes == oldDislikes + (newVote == 'dislike' ? 1 : 0) - (oldVote == 'dislike' ? 1 : 0) &&
             newLikes >= 0 && newDislikes >= 0;
    }

    function incrementsOnlyKey(before, after, key) {
      return after.diff(before).affectedKeys().hasOnly([key]) &&
             after.get(key, 0) == before.get(key, 0) + 1;
    }

    function hasValidViewStatsTransition(before, after) {
      let oldStats = before.get('stats', {});
      let newStats = after.get('stats', {});
      return incrementsOnlyKey(
               oldStats.get('dailyViews', {}),
               newStats.get('dailyViews', {}),
               after.lastViewDailyKey
             ) &&
             incrementsOnlyKey(
               oldStats.get('weeklyViews', {}),
               newStats.get('weeklyViews', {}),
               after.lastViewWeeklyKey
             ) &&
             incrementsOnlyKey(
               oldStats.get('monthlyViews', {}),
               newStats.get('monthlyViews', {}),
               after.lastViewMonthlyKey
             );
    }

    function hasValidReferrerTransition(before, after) {
      let oldReferrers = before.get('referrers', {});
      let newReferrers = after.get('referrers', {});
      return after.get('lastViewReferrerKey', null) == null
               ? newReferrers == oldReferrers
               : incrementsOnlyKey(oldReferrers, newReferrers, after.lastViewReferrerKey);
    }
    
    // User collection rules
    match /users/{userId} {
      // Account documents contain email and other private account data.
      allow read: if isUserAuthenticated(userId);
      allow create: if isUserAuthenticated(userId) &&
                       request.resource.data.uid == userId;
      allow update: if isUserAuthenticated(userId) && 
                     (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']));
      allow delete: if isUserAuthenticated(userId);
    }

    // Public profile data is deliberately separated from private account data.
    match /publicProfiles/{userId} {
      function hasOnlyPublicProfileFields() {
        return request.resource.data.keys()
                 .hasOnly(['uid', 'userTag', 'photoURL', 'lastUpdatedAt']) &&
               request.resource.data.keys().hasAll(['uid', 'userTag', 'photoURL']) &&
               request.resource.data.uid == userId &&
               isValidUserTag(request.resource.data.userTag) &&
               request.resource.data.photoURL is string;
      }

      allow read: if true;
      allow create: if isUserAuthenticated(userId) && hasOnlyPublicProfileFields();
      allow update: if isUserAuthenticated(userId) &&
                       resource.data.uid == userId &&
                       hasOnlyPublicProfileFields();
      allow delete: if isUserAuthenticated(userId);
    }
    
    // UserTags collection rules
    match /userTags/{tag} {
      // Anyone can read a user tag to check availability or look up a user
      allow read: if true;
      
      // Only the authenticated user can create/update/delete their own tag
      // Add validation to ensure the user doesn't already have a tag
      allow create: if isAuthenticated() && 
                     request.resource.data.uid == request.auth.uid &&
                     isValidUserTag(tag);
                     
      allow update: if isAuthenticated() && 
                     resource.data.uid == request.auth.uid &&
                     request.resource.data.uid == request.auth.uid;
                     
      allow delete: if isAuthenticated() && 
                     resource.data.uid == request.auth.uid;
    }
    
    // Nota collection rules
    match /notas/{notaId} {
      // Allow users to read and write their own notas
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Published notas rules
    match /publishedNotas/{notaId} {
      function isValidViewUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        let oldViews = before.get('viewCount', 0);
        let oldUnique = before.get('uniqueViewers', 0);
        let newUnique = after.get('uniqueViewers', 0);
        return after.diff(before).affectedKeys()
                 .hasOnly([
                   'viewCount', 'uniqueViewers', 'lastViewedAt', 'lastViewDailyKey',
                   'lastViewWeeklyKey', 'lastViewMonthlyKey', 'lastViewReferrerKey',
                   'stats', 'referrers'
                 ]) &&
               after.lastViewDailyKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
               after.lastViewWeeklyKey.matches('^[0-9]{4}-[0-9]{2}$') &&
               after.lastViewMonthlyKey.matches('^[0-9]{4}-[0-9]{2}$') &&
               (after.get('lastViewReferrerKey', null) == null ||
                 (after.lastViewReferrerKey is string &&
                  after.lastViewReferrerKey.matches('^[a-zA-Z0-9.-]{1,50}$'))) &&
               after.get('viewCount', 0) == oldViews + 1 &&
               after.lastViewedAt == request.time &&
               hasValidViewStatsTransition(before, after) &&
               hasValidReferrerTransition(before, after) &&
               (newUnique == oldUnique ||
                 (!exists(/databases/$(database)/documents/publishedNotaViewers/$(notaId)/viewers/$(request.auth.uid)) &&
                  existsAfter(/databases/$(database)/documents/publishedNotaViewers/$(notaId)/viewers/$(request.auth.uid)) &&
                  getAfter(/databases/$(database)/documents/publishedNotaViewers/$(notaId)/viewers/$(request.auth.uid))
                    .data.userId == request.auth.uid &&
                  newUnique == oldUnique + 1));
      }

      function isValidSingleCounterUpdate(field) {
        let before = resource.data;
        let after = request.resource.data;
        let delta = after.get(field, 0) - before.get(field, 0);
        return after.diff(before).affectedKeys().hasOnly([field]) &&
               after.get(field, 0) >= 0 &&
               (delta == 1 || (field == 'commentCount' && delta == -1));
      }

      // Anyone can read published notas
      allow read: if true;
      
      // Only the author can create/update/delete their published nota
      allow create: if isAuthenticated() &&
                       request.resource.data.authorId == request.auth.uid &&
                       request.resource.data.id == notaId;
      allow update: if isAuthenticated() && (
        // Full update for author
        (resource.data.authorId == request.auth.uid &&
         request.resource.data.authorId == resource.data.authorId &&
         request.resource.data.id == resource.data.id) ||
        // Non-authors may perform only one exact client operation at a time.
        hasValidVoteTransition(resource.data, request.resource.data) ||
        isValidViewUpdate() ||
        isValidSingleCounterUpdate('commentCount') ||
        isValidSingleCounterUpdate('cloneCount')
      );
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // Published nota viewers tracking
    match /publishedNotaViewers/{notaId} {
      // Only authors can read viewer data (for privacy)
      allow read: if isAuthenticated() && 
                   exists(/databases/$(database)/documents/publishedNotas/$(notaId)) &&
                   get(/databases/$(database)/documents/publishedNotas/$(notaId)).data.authorId == request.auth.uid;
      
      // A viewer may record only their own identity, never inject another UID.
      allow create: if isAuthenticated() &&
                       request.resource.data.keys().hasOnly(['notaId', 'viewers', 'lastUpdated']) &&
                       request.resource.data.notaId == notaId &&
                       request.resource.data.viewers.size() == 1 &&
                       request.resource.data.viewers[0] == request.auth.uid &&
                       request.resource.data.lastUpdated == request.time;
      allow update: if isAuthenticated() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['viewers', 'lastUpdated']) &&
                       request.resource.data.notaId == resource.data.notaId &&
                       resource.data.notaId == notaId &&
                       request.resource.data.viewers.hasAll(resource.data.viewers) &&
                       !resource.data.viewers.hasAny([request.auth.uid]) &&
                       request.resource.data.viewers.hasAny([request.auth.uid]) &&
                       request.resource.data.viewers.size() == resource.data.viewers.size() + 1 &&
                       request.resource.data.lastUpdated == request.time;

      // New clients use one private document per viewer. This lets a viewer
      // check only their own state without exposing the legacy viewers array.
      match /viewers/{viewerId} {
        allow read: if isUserAuthenticated(viewerId);
        allow create: if isUserAuthenticated(viewerId) &&
                         request.resource.data.keys()
                           .hasOnly(['notaId', 'userId', 'firstViewedAt']) &&
                         request.resource.data.notaId == notaId &&
                         request.resource.data.userId == viewerId &&
                         request.resource.data.firstViewedAt == request.time;
        allow update, delete: if false;
      }
    }
    
    // Nota votes collection rules
    match /notaVotes/{voteId} {
      function hasValidIdentity(data) {
        return data.userId == request.auth.uid &&
               voteId == data.notaId + '_' + request.auth.uid;
      }
      
      // A user can inspect only their own dedicated vote document.
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Only the authenticated user can create/update their own vote
      allow create: if isAuthenticated() &&
                     request.resource.data.keys()
                       .hasOnly(['notaId', 'userId', 'voteType', 'createdAt', 'updatedAt']) &&
                     hasValidIdentity(request.resource.data) &&
                     isValidVote(request.resource.data.voteType);
                     
      allow update: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid &&
                     hasValidIdentity(request.resource.data) &&
                     request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['voteType', 'updatedAt']) &&
                     isValidVote(request.resource.data.voteType);
                     
      allow delete: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
    }
    
    // Comments collection rules
    match /comments/{commentId} {
      function isValidReplyCountUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        let delta = after.get('replyCount', 0) - before.get('replyCount', 0);
        return after.diff(before).affectedKeys().hasOnly(['replyCount']) &&
               after.get('replyCount', 0) >= 0 &&
               (delta == 1 || delta == -1);
      }

      // Anyone can read comments on published notas
      allow read: if true;
      
      // Only authenticated users can create comments
      allow create: if isAuthenticated() && 
                    request.resource.data.keys().hasOnly([
                      'id', 'notaId', 'content', 'authorId', 'authorName', 'authorTag',
                      'createdAt', 'updatedAt', 'parentId', 'likeCount',
                      'dislikeCount', 'replyCount', 'votes'
                    ]) &&
                    request.resource.data.id == commentId &&
                    request.resource.data.authorId == request.auth.uid &&
                    request.resource.data.likeCount == 0 &&
                    request.resource.data.dislikeCount == 0 &&
                    request.resource.data.replyCount == 0 &&
                    request.resource.data.get('votes', {}).size() == 0 &&
                    exists(/databases/$(database)/documents/publishedNotas/$(request.resource.data.notaId));
      
      // Update rules: authors can update their own comments
      allow update: if isAuthenticated() && (
        // Option 1: comment author can update their own comment content
        (resource.data.authorId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['content', 'updatedAt'])) ||
        
        // Option 2: exact vote transitions or a one-step reply counter change.
        hasValidVoteTransition(resource.data, request.resource.data) ||
        isValidReplyCountUpdate()
      );
      
      // Delete rules: comment author or nota author can delete comments
      allow delete: if isAuthenticated() && (
        // Comment author can delete their own comment
        resource.data.authorId == request.auth.uid ||
        // Nota author can delete any comment on their nota
        (exists(/databases/$(database)/documents/publishedNotas/$(resource.data.notaId)) &&
         get(/databases/$(database)/documents/publishedNotas/$(resource.data.notaId)).data.authorId == request.auth.uid)
      );
    }
    
    // Newsletter Subscriptions collection rules
    match /newsletterSubscriptions/{userId} {
      // Allow users to create, read and delete their own subscription
      allow read, delete: if isUserAuthenticated(userId);
      allow create: if isUserAuthenticated(userId) && request.resource.data.uid == userId;
      // For now, disallow updates to prevent changing email or other details.
      allow update: if false;
    }
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
