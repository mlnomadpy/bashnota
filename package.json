    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cm6-theme-basic-dark": "^0.2.0",
    "cm6-theme-basic-light": "^0.2.0",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "dompurify": "^3.2.4",
    "file-saver": "^2.0.5",
    "fuse.js": "^7.1.0",
    "highlight.js": "^11.11.1",
