{
  "name": "bashnota",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:iframe-security": "node e2e/iframe-output-sandbox.browser.mjs",
    "test:export-security": "node scripts/export-security-gate.self-test.mjs && vite-node e2e/export-security.browser.ts",
    "test:deploy-workflow": "node scripts/deploy-workflow.self-test.mjs",
    "test:github-pages-deep-links": "node scripts/github-pages-deep-links.self-test.mjs && vitest run src/router/__tests__/deepLinks.test.ts",
    "test:supabase": "npx --yes supabase@2.114.0 db reset && npx --yes supabase@2.114.0 test db && npm run test:supabase:migration && npm run test:supabase:auth && npm run test:supabase:publishing && npm run test:supabase:community",
    "test:migration-engine": "node supabase/tests/migration/migration.engine.self-test.mjs",
    "test:supabase:migration": "node supabase/tests/migration/migration.rehearsal.mjs",
    "migration:legacy": "node scripts/legacy-migration/cli.mjs",
    "migration:legacy:export": "node scripts/legacy-migration/export-cli.mjs",
    "test:supabase:auth": "node supabase/tests/auth/auth.integration.mjs",
    "test:supabase:publishing": "node supabase/tests/publishing/publishing.integration.mjs && RUN_SUPABASE_PUBLISHING_INTEGRATION=true vitest run src/features/nota/stores/__tests__/notaPublishing.integration.test.ts",
    "test:supabase:community": "node supabase/tests/community/community.integration.mjs",
    "test:supabase:upgrade": "npx --yes supabase@2.114.0 db reset --version 20260813000200 --sql-paths ./upgrade/003_legacy_edges_fixture.sql && npx --yes supabase@2.114.0 migration up --local && npx --yes supabase@2.114.0 test db supabase/upgrade/003_upgrade.test.sql",
    "supabase:start": "npx --yes supabase@2.114.0 start",
    "supabase:reset": "npx --yes supabase@2.114.0 db reset",
    "supabase:lint": "npx --yes supabase@2.114.0 db lint --local --level error",
    "supabase:types": "npx --yes supabase@2.114.0 gen types typescript --local --schema public > supabase/types/database.types.ts",
    "build-only": "vite build",
    "check:backend-purity": "node scripts/check-backend-purity.mjs",
    "check:repository-hygiene": "node scripts/repository-hygiene.self-test.mjs",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
