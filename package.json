    "@tanstack/vue-table": "^8.21.3",
    "@types/file-saver": "^2.0.7",
    "@types/jszip": "^3.4.0",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/unist": "^3.0.3",
